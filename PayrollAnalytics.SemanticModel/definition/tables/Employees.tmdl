table Employees
	lineageTag: a31f8e6d-c311-4145-b8df-a10af422335c

	measure Headcount = COUNTROWS(Employees)
		formatString: #,0
		lineageTag: f9019ce1-4cb3-4503-9794-e11fa837e891

	measure 'Active Headcount' = CALCULATE(COUNTROWS(Employees), ISBLANK(Employees[termination_date]))
		formatString: #,0
		lineageTag: d2a35dc6-ea3e-4b29-a9f8-8066eb035d36

	measure 'Attrition Rate' = DIVIDE(COUNTROWS(Employees) - [Active Headcount], COUNTROWS(Employees))
		formatString: 0.0%
		lineageTag: 3b4bb9cb-d93c-4631-a3c0-314da3ccd637

	measure 'Average Salary' = AVERAGE(Employees[base_salary])
		formatString: \$#,0.00
		lineageTag: 6a57238a-d75a-4248-8c1b-c8b112097684

	column employee_id

	partition Employees = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents("C:\Users\vivek\Desktop\java\claude\da\data-analyst\payroll-analytics-dashboard\data\employees.csv"),[Delimiter=",", Columns=9, Encoding=65001, QuoteStyle=QuoteStyle.None]),
				    PromotedHeaders = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    ChangedType = Table.TransformColumnTypes(PromotedHeaders,{{"employee_id", type text},{"name", type text},{"department", type text},{"job_title", type text},{"location", type text},{"hire_date", type date},{"termination_date", type date},{"salary_band", type text},{"base_salary", type number}})
				in
				    ChangedType

